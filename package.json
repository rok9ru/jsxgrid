{
    "name": "jsxgrid",
    "version": "2.0.0",
    "description": "Lightweight data grid jQuery plugin, with a built-in extra field set (avatars, JSON editor, select, collapsible textarea, datetime picker, row selection). A maintained fork of jsGrid.",
    "keywords": [
        "grid",
        "jquery",
        "plugin",
        "jsgrid"
    ],
    "homepage": "https://github.com/rok9ru/jsxgrid#readme",
    "author": "Mikhail Kremza",
    "contributors": [
        {
            "name": "Artem Tabalin",
            "url": "https://github.com/tabalinas"
        }
    ],
    "license": "MIT",
    "main": "dist/jsxgrid.js",
    "directories": {
        "test": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rok9ru/jsxgrid.git"
    },
    "bugs": {
        "url": "https://github.com/rok9ru/jsxgrid/issues"
    },
    "scripts": {
        "build": "grunt",
        "test": "grunt test",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "dist",
        "src"
    ],
    "peerDependencies": {
        "jquery": ">=3.0.0"
    },
    "optionalDependencies": {
        "jsoneditor": "^10.0.0",
        "select2": "4.1.0-rc.0"
    },
    "devDependencies": {
        "grunt": "^1.6.2",
        "grunt-cli": "^1.5.0",
        "grunt-contrib-clean": "^2.0.1",
        "grunt-contrib-concat": "~2.1.0",
        "grunt-contrib-copy": "^1.0.0",
        "grunt-contrib-cssmin": "^5.0.0",
        "grunt-contrib-qunit": "^10.2.0",
        "grunt-contrib-uglify": "^5.2.2"
    }
}
